    <VersionPrefix>0.4.0</VersionPrefix>
    <PackageId>Biz.Morsink.Results</PackageId>
    <Description>A result class and utility for failures.</Description>
    <PackageProjectUrl>https://github.com/joost-morsink/Biz.Morsink.Results</PackageProjectUrl>
    <RootNamespace>Biz.Morsink.Results</RootNamespace>
    <Copyright>(C) 2020 Joost W. Morsink</Copyright>
    <PackageTags>Results</PackageTags>
